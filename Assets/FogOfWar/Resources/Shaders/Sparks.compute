// Impact sparks (docs/design-combat.md "The sparks (fx-2)"), one thread a piece. A piece is worked out from its burst's seed
// and age alone: no state is kept between frames. The live ones bright enough to see are appended for Sparks.shader's
// indirect draw. Positions are in metres in the ship's frame (Unity axes, origin at the hull's middle, not turning with it).
#pragma kernel Sparks

#define PER_BURST 32768
#define SIGMA 5.670e-8
#define EPS 0.3          // [design] emissivity of the molten droplets
#define RHO 2700.0       // [design] aluminium, kg/m³
#define RHOC 2.7e6       // [design] ρ·c, J/(m³·K)
#define SUN_WM2 1361.0
#define TMIN 1000.0      // gone below this: the visible share is 1.6e-6 of the Sun's
#define SPEED_SLOPE 1.65 // mass faster than v ∝ v^-1.65
#define RMIN 1e-4
#define RMAX 1e-3
#define ALBEDO 0.3       // [design] the chunks' geometric albedo
#define TURNS 3.0        // [design] the chunks' fastest tumble, turns/s

struct Burst
{
    float3 origin; float age;     // m, s
    float3 axis; float hotCos;    // the spray's axis and the cos of its half-angle
    float3 vBase; float vMin;     // m/s: the velocity every piece shares (the missile's, for a kill); the slowest hot piece
    float3 disp; float vMax;      // m: what the ship's burns since the burst moved it; the fastest hot piece
    float hotKg; float coldKg; float coldVMin; float coldVMax;
    uint nHot; uint nCold; uint seed; float coldCos;
    uint absorb; uint pad0; uint pad1; uint pad2;
};

struct Spark { float3 head; float3 tail; float3 col; };  // world positions now and a shutter ago; linear RGB, luminance = E

StructuredBuffer<Burst> _Bursts;
uint _BurstCount;
AppendStructuredBuffer<Spark> _Out;
Texture2D<float4> _BlackbodyLUT;   // log10 T from 3 to 4: rgb the colour at unit luminance, a the visible share
SamplerState sampler_linear_clamp;
float4x4 _ToWorld;                 // ship frame (m) -> world
float4x4 _ToHull;                  // ship frame (m) -> the hull's ellipsoid as a unit sphere
float3 _CamM;                      // the camera in the ship frame, m
float3 _SunDir;                    // unit, toward the Sun
float _SunIrr;                     // sunlight at the ship, eclipse included, 1 at 1 AU
float _Shutter;                    // s: a streak is where the piece was this long ago
float _MinE;                       // light at the eye below which a piece is not drawn, sunlight units

uint Pcg(uint v)
{
    uint s = v * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}

float Rnd(inout uint s)
{
    s = Pcg(s);
    return (s & 0xFFFFFFu) / 16777216.0;
}

// uniform over the cap within the cone, about `axis`
float3 InCone(float3 axis, float cosMax, inout uint s)
{
    float c = lerp(1.0, cosMax, Rnd(s));
    float sn = sqrt(saturate(1.0 - c * c));
    float ph = 6.2831853 * Rnd(s);
    float3 t = normalize(cross(axis, abs(axis.y) < 0.9 ? float3(0, 1, 0) : float3(1, 0, 0)));
    float3 b = cross(axis, t);
    return axis * c + (t * cos(ph) + b * sin(ph)) * sn;
}

// The straight path from `o` at velocity `v` meets the hull's ellipsoid within `age`
bool MeetsHull(float3 o, float3 v, float age)
{
    float3 p = mul(_ToHull, float4(o, 1)).xyz, d = mul((float3x3)_ToHull, v * age);
    float a = dot(d, d), b = dot(p, d), c = dot(p, p) - 1.0;
    if (c <= 0.0) return true;
    float disc = b * b - a * c;
    if (disc < 0.0 || a <= 0.0) return false;
    float t = (-b - sqrt(disc)) / a;
    return t >= 0.0 && t <= 1.0;
}

float4 Lut(float kelvin)
{
    float u = saturate(log10(kelvin) - 3.0);
    return _BlackbodyLUT.SampleLevel(sampler_linear_clamp, float2((u * 255.0 + 0.5) / 256.0, 0.5), 0);
}

[numthreads(64, 1, 1)]
void Sparks(uint3 id : SV_DispatchThreadID)
{
    uint bi = id.x / PER_BURST, i = id.x % PER_BURST;
    if (bi >= _BurstCount) return;
    Burst b = _Bursts[bi];
    bool hot = i < b.nHot;
    if (!hot && i >= b.nHot + b.nCold) return;

    uint s = Pcg(b.seed ^ Pcg(i + 1u));
    float3 vel;
    float lum;
    float3 col;
    float3 pos;
    float age = b.age;
    if (hot)
    {
        // the cratering law's speeds, faster ones nearer white
        float v = min(b.vMin * pow(max(Rnd(s), 1e-7), -1.0 / SPEED_SLOPE), b.vMax);
        vel = b.vBase + InCone(b.axis, b.hotCos, s) * v;
        float r = exp(lerp(log(RMIN), log(RMAX), Rnd(s)));
        float t0 = 2000.0 + 2500.0 * sqrt(v / b.vMax);
        float tau = RHOC * r / (9.0 * EPS * SIGMA * t0 * t0 * t0);
        float T = t0 * pow(1.0 + age / tau, -1.0 / 3.0);
        if (T < TMIN) return;
        pos = b.origin + vel * age - b.disp;
        float4 lut = Lut(T);
        // radiative power of this piece's share of the hot mass: (M_h / n) · 3·ε·σ·T⁴ / (ρ·r), visible part only
        float watts = b.hotKg / b.nHot * 3.0 * EPS * SIGMA * T * T * T * T / (RHO * r) * lut.a;
        float3 q = pos - _CamM;
        lum = watts / (12.566371 * max(dot(q, q), 1e-4)) / SUN_WM2;
        col = lut.rgb;
    }
    else
    {
        float v = lerp(b.coldVMin, b.coldVMax, Rnd(s));
        vel = b.vBase + InCone(b.coldCos < 0.0 ? float3(0, 0, 1) : b.axis, b.coldCos, s) * v;
        float R = pow(3.0 * b.coldKg / b.nCold / (12.566371 * RHO), 1.0 / 3.0);
        float spin = 6.2831853 * TURNS * Rnd(s), phase = 6.2831853 * Rnd(s);
        pos = b.origin + vel * age - b.disp;
        float3 q = pos - _CamM;
        float d2 = max(dot(q, q), 1e-4);
        // a Lambert sphere's phase law, and a flat face that flashes as it turns: on average the sphere's light
        float alpha = acos(clamp(dot(_SunDir, -q * rsqrt(d2)), -1.0, 1.0));
        float phi = (sin(alpha) + (3.14159265 - alpha) * cos(alpha)) / 3.14159265;
        float glint = 0.5 + 4.0 * pow(abs(cos(spin * age + phase)), 40.0);
        lum = _SunIrr * ALBEDO * R * R / d2 * phi * glint;
        col = float3(1, 1, 1);
    }
    if (lum < _MinE) return;
    if (b.absorb != 0u && MeetsHull(b.origin, vel, age)) return;

    Spark o;
    o.head = mul(_ToWorld, float4(pos, 1)).xyz;
    o.tail = mul(_ToWorld, float4(pos - vel * min(_Shutter, age), 1)).xyz;
    o.col = col * lum;
    _Out.Append(o);
}
